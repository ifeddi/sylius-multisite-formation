      "Edit(./ecs.php)",
      "Edit(./scripts/**)",
      "Edit(./tests/Formation/Scripts/**)",
      "Edit(./tests/Formation/Agents/**)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(composer validate *)",
      "Bash(composer audit *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose exec -T -e XDEBUG_MODE=off php vendor/bin/phpunit tests/Formation*)",
      "Bash(docker compose exec -T -e XDEBUG_MODE=off php vendor/bin/ecs check *)",
